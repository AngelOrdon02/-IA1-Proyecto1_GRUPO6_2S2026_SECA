# =============================================================================
# Logic Detective — plantilla de configuracion
# -----------------------------------------------------------------------------
# Copiar a .env y rellenar con valores reales:
#
#     cp .env.example .env
#
# .env esta en .gitignore y NO debe subirse nunca al repositorio.
# docker-compose lo lee automaticamente desde la raiz del proyecto.
# =============================================================================

# --- Modulo administrativo ---------------------------------------------------
# OBLIGATORIO cambiarlos antes de exponer el sistema en la nube: el panel /admin
# permite editar la base de conocimiento Prolog, y ese contenido se ejecuta en
# el servidor. Unas credenciales debiles equivalen a ejecucion remota de codigo.
# Generar una clave larga:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
LD_ADMIN_USER=cambiar_usuario
LD_ADMIN_PASS=cambiar_por_una_clave_larga_y_aleatoria

# --- Motor Prolog ------------------------------------------------------------
# auto | pyswip | subprocess
LD_PROLOG_BACKEND=auto
LD_PROLOG_KB=prolog/logic_detective.pl
LD_SWIPL_BIN=swipl
LD_TIMEOUT=30

# --- Persistencia ------------------------------------------------------------
LD_DB=datos/logic_detective.db

# --- Casos de ejemplo del panel ----------------------------------------------
# Solo hace falta tocarla si los ejemplos no estan junto al codigo. La imagen
# Docker la fija a /app/ejemplos, fuera del volumen de datos.
LD_EJEMPLOS=datos/ejemplos
